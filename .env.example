# ============================================================
# Wayhug IP Lab 环境变量示例（复制为 .env 后填写）
# 未填写的项会自动降级：SMTP 未配置 → 人工答复；IMAP 未开启 → 仅网页流程
# ============================================================

# —— 基础 ——
PORT=3001
LAB_SITE_URL=https://wayhug.com
LAB_CONTACT_EMAIL=bc.xu@hotmail.com
LAB_OWNER_EMAIL=xubicheng@qq.com
# 后台令牌：/lab/admin 与管理 API 使用，务必改成随机长串
LAB_ADMIN_TOKEN=change-me-to-a-random-token
# 是否自动回复访客（true 时需配置 SMTP；false 时进入人工待办）
LAB_AUTO_REPLY=false
# 邮件主题前缀，用于与 jshnp.com 的邮件隔离
LAB_MAIL_PREFIX=[WAYHUG]

# —— 中文字体（可选，留空自动探测系统字体）——
LAB_FONT_PATH=
LAB_FONT_FAMILY=

# —— SMTP 发信 ——
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# —— IMAP 指令轮询（S2）——
LAB_IMAP_ENABLED=false
MAIL_IMAP_HOST=imap.qq.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_IMAP_USER=
MAIL_IMAP_PASS=
MAIL_IMAP_INTERVAL_MS=120000
# 允许的发件人白名单，逗号分隔；留空表示不限制
MAIL_IMAP_SENDERS=
